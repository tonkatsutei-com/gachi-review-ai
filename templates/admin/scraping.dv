<div class="wrap gachireai-admin">
	{% partials/page-head.dv %}
	{% partials/tabs.dv %}
	{% partials/scraping-legend.dv %}
	?$sections
	[$sections]
	<section class="gachireai-section" id="gachireai-section-{$section_key}">
		{% partials/scraping-section-head.dv %}
		<div class="gachireai-section__main">
			<form method="post" action="{$form_action}">
				?$hidden_fields
				[$hidden_fields]
				<input type="hidden" name="{$name}" value="{$value}">
				[/$hidden_fields]
				$hidden_fields?
				?$switch
				<div class="gachireai-section__switch">
					[$switch]
					{% partials/field-inline.dv %}
					[/$switch]
				</div>
				$switch?
				<table class="form-table" role="presentation">
					<tr class="gachireai-field" ?$common_target data-gachireai-common-target="{$common_target}"$common_target?>
						<th scope="row"><label for="{$field_id}">{$field_label}</label></th>
						<td>
							<input type="text" id="{$field_id}" name="{$field_name}" value="{$field_value}" class="regular-text" autocomplete="off" spellcheck="false" ?$placeholder placeholder="{$placeholder}"$placeholder?>
						</td>
					</tr>
				</table>
				<p class="submit">
					<button type="submit" class="button button-primary">{$save_label}</button>
					?$status_text
					<span class="description gachireai-scraping-status">{$status_text}</span>
					$status_text?
				</p>
				?$messages
				<div class="gachireai-section__messages">
					[$messages]
					<div class="notice inline notice-{$msg_type}"><p>{$msg_text}</p></div>
					[/$messages]
				</div>
				$messages?
			</form>
		</div>
	</section>
	[/$sections]
	$sections?
</div>
