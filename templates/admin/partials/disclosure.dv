<form method="post" action="{$disclosure_form_action}">
	?$disclosure_hidden_fields
	[$disclosure_hidden_fields]
	<input type="hidden" name="{$name}" value="{$value}">
	[/$disclosure_hidden_fields]
	$disclosure_hidden_fields?
	<section class="gachireai-section" ?$disclosure_anchor id="gachireai-section-{$disclosure_anchor}"$disclosure_anchor?>
		<header class="gachireai-section__header">
			<h2 class="gachireai-section__title">{$disclosure_title}</h2>
			?$disclosure_intro
			<p class="gachireai-section__desc gachireai-section__desc--preline">{$disclosure_intro}</p>
			$disclosure_intro?
		</header>
		<div class="gachireai-section__main">
			?$disclosure_blocks
			[$disclosure_blocks]
			<div class="gachireai-block">
				?$block_title
				<h3 class="gachireai-block__title">{$block_title}</h3>
				$block_title?
				<div class="gachireai-block__main">
					<table class="form-table gachireai-disclosure-table" role="presentation">
						?$rows
						[$rows]
						<tr>
							?$has_th
							<th scope="row">{$th_label}</th>
							$has_th?
							<td>
								?$is_input
								<input type="text" name="{$input_name}" value="{$input_value}" class="regular-text" placeholder="{$placeholder}">
								$is_input?
								?$is_item
								<label class="gachireai-disclosure-check"><input type="checkbox" name="{$checkbox_name}" value="1" ?$checked checked$checked?> {$checkbox_label}</label>
								<br>
								<textarea name="{$text_name}" rows="2" class="large-text" placeholder="{$placeholder}">{$text_value}</textarea>
								$is_item?
							</td>
						</tr>
						[/$rows]
						$rows?
					</table>
				</div>
			</div>
			[/$disclosure_blocks]
			$disclosure_blocks?
		</div>
		<footer class="gachireai-section__footer">
			<div class="gachireai-section__actions">
				<button type="submit" class="button button-primary">{$disclosure_submit_label}</button>
			</div>
			<div class="gachireai-section__messages">
				?$disclosure_messages
				[$disclosure_messages]
				<div class="notice notice-{$msg_type}"><p>{$msg_text}</p></div>
				[/$disclosure_messages]
				$disclosure_messages?
			</div>
		</footer>
	</section>
</form>
